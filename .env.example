# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string used by the SSR mock API.
# Example local setup:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/project_resource_mgmt"
DATABASE_URL=""

# PGSSL: set to "true" for managed PostgreSQL providers that require SSL.
PGSSL="false"

# APP_STATE_KEY: logical key for the JSONB app state row in PostgreSQL.
APP_STATE_KEY="project-resource-mgmt"

# API_BASE_URL: server-side Angular HTTP base URL. Keep 127.0.0.1 for local SSR.
API_BASE_URL="http://127.0.0.1:3000/api"

# NG_ALLOWED_HOSTS: hostnames allowed by Angular SSR host validation.
NG_ALLOWED_HOSTS="localhost,127.0.0.1"
