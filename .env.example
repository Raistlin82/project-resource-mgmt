# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string used by the SSR mock API.
# Points at the 'postgres' service from docker-compose.yml (the APP database).
# Sample (uncomment and fill in; must match the POSTGRES_* compose vars below):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/project_resource_mgmt"
DATABASE_URL=""

# PERSISTENCE_ADAPTER: optional explicit adapter selector (`memory` or
# `postgresql`). Unknown values fail startup. Production requires `postgresql`;
# local development may omit it and keeps the DATABASE_URL-based default.
PERSISTENCE_ADAPTER=""

# SEED_DEMO_DATA: exact boolean. Defaults to true outside production and false
# in production. Set true in production only for an explicitly demo deployment.
SEED_DEMO_DATA=""

# PGSSL: set to "true" for managed PostgreSQL providers that require SSL.
# Leave "false" for the local docker-compose Postgres (no TLS).
PGSSL="false"

# PG_CA_CERT: PEM-encoded CA certificate for verifying the PostgreSQL server's
# TLS cert (managed providers that hand you a CA bundle). Only consulted when
# PGSSL="true". Leave empty for the local docker-compose Postgres.
# Accepts either an inline PEM (\n-escaped) or a path, depending on the SSR loader.
PG_CA_CERT=""

# APP_STATE_KEY: legacy snapshot key — logical key for the JSONB app-state row
# persisted in PostgreSQL. Retained for the older single-row snapshot storage.
APP_STATE_KEY="project-resource-mgmt"

# --- Authentication (Keycloak / OIDC) ---------------------------------------
# OIDC_ISSUER: the 'psa' realm issuer URL. Host port is 8081 (NOT 8080 — that
# host port is owned by openHAB), so the externally reachable issuer is :8081.
OIDC_ISSUER="http://localhost:8081/realms/psa"

# Browser-facing issuer and public SPA client. Set OIDC_PUBLIC_ISSUER when the
# API reaches Keycloak through a different internal hostname than browsers use.
OIDC_PUBLIC_ISSUER="http://localhost:8081/realms/psa"
OIDC_CLIENT_ID="psa-web"

# OIDC_AUDIENCE: required in production. The bundled realm mapper adds psa-web
# to access-token `aud`, preventing cross-client/confused-deputy replay.
OIDC_AUDIENCE="psa-web"

# Optional internal JWKS URL. It may use a container-only hostname while
# OIDC_ISSUER remains the public value that must match the token's `iss` claim.
OIDC_JWKS_URI=""

# AUTH_TRUST_HEADERS: DEV-ONLY. When "true", the server trusts the spoofable
# X-User-Id / X-User-Role demo headers for identity. NEVER enable this in any
# environment reachable by untrusted clients (including behind a TLS-terminating
# reverse proxy on a loopback bind). Header trust is NOT inferred from the bind
# host; it requires this explicit opt-in. Production uses verified JWTs only.
AUTH_TRUST_HEADERS="false"

# --- docker-compose: Postgres -----------------------------------------------
# Consumed by the 'postgres' service. POSTGRES_DB is the APP database; the
# separate Keycloak database is created by postgres/init/01-create-keycloak-db.sql.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="project_resource_mgmt"
# Host port the Postgres container is published on (container side stays 5432).
POSTGRES_PORT="5432"

# --- docker-compose: Keycloak -----------------------------------------------
# Name of the SEPARATE Keycloak database inside the shared Postgres instance.
# Must match the database created by the init SQL script.
KC_DB_NAME="keycloak"
# Credentials Keycloak uses to reach Postgres (default to the POSTGRES_* above).
KC_DB_USERNAME="postgres"
KC_DB_PASSWORD="postgres"
# Temporary bootstrap admin for the Keycloak master realm (admin console login).
KC_BOOTSTRAP_ADMIN_USERNAME="admin"
KC_BOOTSTRAP_ADMIN_PASSWORD="admin"
# Externally reachable Keycloak base URL. MUST use host port 8081, since the
# container's 8080 is published on the host as 8081 (openHAB owns host 8080).
KC_HOSTNAME="http://localhost:8081"

# API_BASE_URL: server-side Angular HTTP base URL used during SSR. SSR calls back
# into THIS server's own /api, so the host:port must match where the server binds.
# Leave UNSET to let it auto-derive from PORT (+ HOST); set it only to point SSR at
# a different origin (e.g. an external API). If you do set it, keep the port in sync
# with PORT — a stale :3000 here makes deep-linked param routes render an empty shell.
API_BASE_URL="http://127.0.0.1:3000/api"

# NG_ALLOWED_HOSTS: hostnames allowed by Angular SSR host validation.
NG_ALLOWED_HOSTS="localhost,127.0.0.1"
